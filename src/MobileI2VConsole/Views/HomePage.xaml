
<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MobileI2VConsole.ViewModels"
    xmlns:models="clr-namespace:MobileI2VConsole.Models"
    x:Class="MobileI2VConsole.Views.HomePage"
    x:DataType="vm:HomeViewModel"
    Title="JN AI Studio"
    BackgroundColor="#101522">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="JN AI Studio"
                FontSize="30"
                FontAttributes="Bold"
                TextColor="#FFFFFF"
                HorizontalOptions="Center"/>

            <Label
                Text="Create Images • Animate Stickman • Generate Videos"
                FontSize="13"
                TextColor="#B8C4D9"
                HorizontalTextAlignment="Center"/>

            <Label
                Text="IMAGE TO VIDEO"
                FontSize="18"
                FontAttributes="Bold"
                TextColor="#F5C451"/>

            <Border
                Stroke="#40516B"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="#192438"
                Padding="12">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Select your image"
                        TextColor="White"
                        FontAttributes="Bold"/>

                    <Image
                        Source="{Binding ImagePreview}"
                        Aspect="AspectFit"
                        HeightRequest="220"/>

                    <Button
                        Text="📁 Choose Image from Gallery"
                        Command="{Binding PickImageCommand}"
                        BackgroundColor="#2864D8"
                        TextColor="White"/>

                    <Button
                        Text="📷 Capture Image"
                        Command="{Binding CaptureImageCommand}"
                        BackgroundColor="#35445D"
                        TextColor="White"/>

                </VerticalStackLayout>
            </Border>

            <Label
                Text="IMAGE RATIO"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="#F5C451"/>

            <Picker
                Title="Select Image Ratio"
                SelectedItem="{Binding SelectedImageRatio}"
                BackgroundColor="#192438"
                TextColor="White">
                <Picker.Items>
                    <x:String>9:16</x:String>
                    <x:String>16:9</x:String>
                    <x:String>1:1</x:String>
                    <x:String>4:5</x:String>
                </Picker.Items>
            </Picker>

            <Label
                Text="VIDEO RATIO"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="#F5C451"/>

            <Picker
                Title="Select Video Ratio"
                SelectedItem="{Binding SelectedVideoRatio}"
                BackgroundColor="#192438"
                TextColor="White">
                <Picker.Items>
                    <x:String>9:16</x:String>
                    <x:String>16:9</x:String>
                    <x:String>1:1</x:String>
                    <x:String>4:5</x:String>
                </Picker.Items>
            </Picker>

            <Label
                Text="Describe Your Animation"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="White"/>

            <Editor
                Text="{Binding PromptText}"
                Placeholder="Describe the movement, camera and scene..."
                PlaceholderColor="#91A0B8"
                TextColor="White"
                BackgroundColor="#192438"
                HeightRequest="110"
                AutoSize="TextChanges"/>

            <Label
                Text="QUICK PROMPTS"
                FontSize="14"
                FontAttributes="Bold"
                TextColor="#F5C451"/>

            <CollectionView
                ItemsSource="{Binding PromptTemplates}"
                HeightRequest="65"
                ItemsLayout="HorizontalList">

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:PromptTemplate">
                        <Border
                            BackgroundColor="#243956"
                            Stroke="#526D96"
                            StrokeShape="RoundRectangle 12"
                            Padding="12"
                            Margin="3">

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding
                                        Source={RelativeSource AncestorType={x:Type ContentPage}},
                                        Path=BindingContext.ApplyTemplateCommand}"
                                    CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>

                            <Label
                                Text="{Binding Name}"
                                TextColor="White"
                                VerticalOptions="Center"/>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border
                BackgroundColor="#192438"
                Stroke="#40516B"
                StrokeShape="RoundRectangle 14"
                Padding="14">

                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="ONNX MODEL STATUS"
                        FontAttributes="Bold"
                        TextColor="#F5C451"/>

                    <Label
                        Text="{Binding DownloadStatusText}"
                        TextColor="White"/>

                    <ProgressBar
                        Progress="{Binding DownloadProgress}"
                        ProgressColor="#42C98A"
                        IsVisible="{Binding IsDownloading}"/>

                    <Button
                        Text="📦 Import ONNX Models"
                        Command="{Binding ImportModelsCommand}"
                        BackgroundColor="#2864D8"
                        TextColor="White"/>

                </VerticalStackLayout>
            </Border>

            <Button
                Text="✨ GENERATE VIDEO"
                Command="{Binding GenerateCommand}"
                BackgroundColor="#E5A82E"
                TextColor="#101522"
                FontAttributes="Bold"
                FontSize="18"
                HeightRequest="58"
                CornerRadius="14"/>

            <Label
                Text="JN AI Studio • Personal AI Creation Studio"
                TextColor="#8391A8"
                FontSize="11"
                HorizontalOptions="Center"
                Margin="0,10,0,15"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
